# --- Local development (docker-compose.yml) ---
# Bring the DB up with: docker compose up -d
# Values below are consumed both by docker-compose.yml (container
# provisioning) and by Prisma (DATABASE_URL). Change the passwords.
MARIADB_DATABASE=db_kep_lppm_unsoed
MARIADB_USER=usipetif
MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me-too
# Host port the container is published on - 3306/3307 are commonly already
# taken by other local containers, hence a non-default port here.
DB_PORT=3308

DATABASE_URL="mysql://usipetif:change-me@127.0.0.1:3308/db_kep_lppm_unsoed"

# --- Production (CloudPanel VPS, local MariaDB 11.4.5, no Docker) ---
# DATABASE_URL="mysql://usipetif:PASSWORD@127.0.0.1:3306/db_name"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Resend (free tier). onboarding@resend.dev works with any Resend API key
# before you've verified a sending domain; switch to a noreply@ address on
# your own verified domain once that's set up in the Resend dashboard.
RESEND_API_KEY="re_xxxxxxxxxxxx"
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Local file storage - omit for local dev (defaults to <project>/public/uploads).
# On the CloudPanel VPS, point this outside the public web root:
# UPLOAD_DIR="/home/cloudpanel/htdocs/ec-kep.unsoed.ac.id/storage/uploads"

# --- Vercel deployment only (see README > Deployment (Vercel)) ---
# Auto-populated by Vercel when a Blob store is connected to the project
# (Storage tab -> Create Database -> Blob). Leave unset for local dev and
# for the CloudPanel VPS - lib/storage.ts falls back to local disk when
# this is absent.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` when
# it calls /api/cron/reminders. Generate with: openssl rand -base64 32
# CRON_SECRET="generate-with-openssl-rand-base64-32"
